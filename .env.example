# Upstash Redis, attached through the Vercel Marketplace and pulled with
# `vercel env pull .env.local --yes`. Never commit a filled-in copy.
#
# `Redis.fromEnv()` accepts either pair: it reads UPSTASH_REDIS_REST_URL or,
# failing that, KV_REST_API_URL, and the matching token. Which pair the
# Marketplace injects is confirmed with `vercel env ls` after the integration
# is attached; both are listed here so either works.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

KV_REST_API_URL=
KV_REST_API_TOKEN=
